# Copie para .env e preencha. O .env NÃO vai para o Git.

# ── banco de dados ──
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque_esta_senha

# ── autenticação ──
# gere uma chave nova:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere_uma_chave_nova_veja_o_comando_acima
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── aplicação ──
TZ=America/Sao_Paulo
